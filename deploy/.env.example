# Copy to `.env` (gitignored) and fill in. Consumed by docker-compose.yml.

# Public hostname Caddy serves and obtains a TLS cert for. Point its DNS at
# this host first. Required when running the bundled caddy service.
KS_DOMAIN=api.kickstand.example

# CORS allow-list: the web app's origin(s), comma-separated. REQUIRED in prod
# — the API fails closed and blocks unknown origins.
KS_CORS_ALLOWED_ORIGINS=https://app.kickstand.example

# Firebase Admin credentials (ID-token verification + provisioning). The path
# is INSIDE the container; put the service-account JSON at deploy/secrets/ ,
# which is mounted read-only at /secrets.
FIREBASE_PROJECT_ID=kickstand-prod
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-sa.json

# Optional: Firebase Storage / GCS bucket for receipt images. Empty → receipts
# are stored on the local /data volume instead.
FIREBASE_STORAGE_BUCKET=

# Dedicated single-tenant instance: pin every signup to one school id (the id
# printed by `provision`). Leave EMPTY for a shared multi-tenant deployment.
KS_SINGLE_TENANT_SCHOOL_ID=
