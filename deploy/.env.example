# Copy to `.env` (gitignored) and fill in. Consumed by docker-compose.yml.

# Public hostname Caddy serves and obtains a TLS cert for. Point its DNS at
# this host first. Required when running the bundled caddy service.
KS_DOMAIN=api.kickstand.example

# CORS allow-list: the web app's origin(s), comma-separated. REQUIRED in prod
# — the API fails closed and blocks unknown origins.
CORS_ALLOWED_ORIGINS=https://app.kickstand.example

# Auth signing key — REQUIRED in prod. Hand-rolled email/password auth signs
# HS256 access + refresh tokens with this secret. Generate ≥32 random bytes
# and keep it secret (rotating it invalidates every outstanding token):
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Base URL of the web page that handles a password-reset link. The emailed
# link is <WEB_APP_URL>?token=... . Empty → the email carries the raw token.
WEB_APP_URL=https://app.kickstand.example/reset-password

# Transactional email (booking confirmations, reminders, cancellations AND
# password-reset links). Set SMTP_HOST to enable real sending; any SMTP relay
# works (SendGrid/SES/Mailgun/Postmark). With none set, email queues but isn't
# sent — password reset still returns 204 but no link goes out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@kickstand.example
EMAIL_FROM_NAME=Kickstand
# Dev/staging: EMAIL_LOG=1 logs emails instead of sending (ignored if
# SMTP_HOST is set).
EMAIL_LOG=

# Receipt images are stored on the local /data volume — no cloud bucket needed.

# Optional crash alerts: a webhook (Slack/Discord/collector) that receives
# {"text":"..."} when a handler panics. Empty = disabled.
ERROR_WEBHOOK=

# Dedicated single-tenant instance: pin every signup to one school id (the id
# printed by `provision`). Leave EMPTY for a shared multi-tenant deployment.
KS_SINGLE_TENANT_SCHOOL_ID=
