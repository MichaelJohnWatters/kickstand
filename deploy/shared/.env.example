# Copy to `.env` (gitignored) and fill in. Consumed by this shared compose.

# ---- Domains (both point their DNS at this host) ----
KS_DOMAIN=kickstand.example
YOGA_DOMAIN=yogaschool.example

# ---- Kickstand (same knobs as the single-app deploy) ----
CORS_ALLOWED_ORIGINS=https://app.kickstand.example
FIREBASE_PROJECT_ID=kickstand-prod
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-sa.json
FIREBASE_STORAGE_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@kickstand.example
EMAIL_FROM_NAME=Kickstand
EMAIL_LOG=
ERROR_WEBHOOK=
KS_SINGLE_TENANT_SCHOOL_ID=

# ---- yoga-school (fill in from its own project) ----
# The container image to run (built/pushed separately, or a local tag).
YOGA_IMAGE=yoga-school:latest
# Where Caddy proxies its domain — service:port on the compose network.
# Change the port if yoga-school doesn't listen on 8080.
YOGA_UPSTREAM=yoga-school:8080
YOGA_INTERNAL_PORT=8080
# yoga-school's own env (rename/extend to match its config).
YOGA_ENV_EXAMPLE=
